# Environment Configuration for AgoraDesk/LocalMonero Android App
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with actual credentials!

# ====================================================================
# BACKEND RPC CONFIGURATION
# ====================================================================

# Bitcoin Core RPC
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USER=bitcoinrpc
BITCOIN_RPC_PASSWORD=your_bitcoin_rpc_password_here

# Monero Wallet RPC
MONERO_RPC_URL=http://localhost:18082
MONERO_RPC_USER=monerorpc
MONERO_RPC_PASSWORD=your_monero_rpc_password_here

# ====================================================================
# API KEYS
# ====================================================================

# MapBox API Key (for geocoding)
MAPBOX_API_KEY=your_mapbox_api_key_here

# CoinGecko API (no key required for public API)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ====================================================================
# SECURITY
# ====================================================================

# JWT Secret Key (generate a strong random key)
# Example: openssl rand -base64 64
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long

# JWT Expiration (in milliseconds)
# 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000

# ====================================================================
# ANDROID BUILD CONFIGURATION
# ====================================================================

# Keystore Configuration (for production builds)
# AgoraDesk
AGORADESK_KEYSTORE_PATH=/path/to/agoradesk-release-key.jks
AGORADESK_KEYSTORE_PASSWORD=your_keystore_password
AGORADESK_KEY_ALIAS=agoradesk
AGORADESK_KEY_PASSWORD=your_key_password

# LocalMonero
LOCALMONERO_KEYSTORE_PATH=/path/to/localmonero-release-key.jks
LOCALMONERO_KEYSTORE_PASSWORD=your_keystore_password
LOCALMONERO_KEY_ALIAS=localmonero
LOCALMONERO_KEY_PASSWORD=your_key_password

# ====================================================================
# DOCKER CONFIGURATION
# ====================================================================

# Docker network
DOCKER_NETWORK=crypto-network

# Bitcoin Docker settings
BITCOIN_DATA_PATH=./docker/bitcoin/data
BITCOIN_CONF_PATH=./docker/bitcoin/bitcoin.conf

# Monero Docker settings
MONERO_DATA_PATH=./docker/monero/data
MONERO_CONF_PATH=./docker/monero/monero-wallet.conf

# ====================================================================
# FIREBASE (Optional - for Google Play builds)
# ====================================================================

# Firebase project IDs
FIREBASE_PROJECT_ID_AGORADESK=your-agoradesk-project-id
FIREBASE_PROJECT_ID_LOCALMONERO=your-localmonero-project-id

# ====================================================================
# SENTRY (Optional - for error tracking)
# ====================================================================

SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# ====================================================================
# APP CONFIGURATION
# ====================================================================

# Debug logging (true/false)
DEBUG_LOGGING=false

# Check for updates (true/false)
CHECK_UPDATES=true

# ====================================================================
# PRODUCTION DEPLOYMENT
# ====================================================================

# Google Play Console Service Account JSON
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Upload track (internal, alpha, beta, production)
GOOGLE_PLAY_TRACK=internal

# ====================================================================
# DEVELOPMENT SETTINGS
# ====================================================================

# Local development
LOCAL_BITCOIN_NODE=true
LOCAL_MONERO_NODE=true

# Test network (true for testnet)
USE_TESTNET=false
