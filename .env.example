# ─────────────────────────────────────────────────────────────
# WP Guardian — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── WordPress installation ────────────────────────────────────
WP_CONFIG_PATH=/var/www/html/wp-config.php
WP_ROOT=/var/www/html
WP_SITE_URL=https://example.com

# ── Health check ─────────────────────────────────────────────
# Interval between HTTP health checks (seconds)
HEALTH_INTERVAL_SECONDS=60
# Request timeout (seconds)
HEALTH_TIMEOUT_SECONDS=15
# Number of consecutive failures before auto-restart is triggered
MAX_FAILURES_BEFORE_RESTART=3

# ── SSH — remote service restart ──────────────────────────────
SSH_HOST=your.server.example.com
SSH_PORT=22
SSH_USER=deploy
SSH_KEY_PATH=~/.ssh/id_rsa
# Name of the systemd service to restart on failure
SYSTEMD_SERVICE=apache2

# ── Cloudflare (optional) ─────────────────────────────────────
CF_ZONE_ID=
CF_API_TOKEN=

# ── WPScan API (optional) ─────────────────────────────────────
# Obtain a free token at https://wpscan.com/api
WPSCAN_API_TOKEN=

# ── Email alerts ──────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme
ALERT_FROM=wp-guardian@example.com
ALERT_TO=admin@example.com

# ── Webhook alerts ────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── File integrity baseline ───────────────────────────────────
HASH_BASELINE_FILE=wp_file_hashes.json

# ── Log file ─────────────────────────────────────────────────
WP_LOG_FILE=wp_guardian.log
