[Unit]
Description=WP Guardian — WordPress site maintenance and monitoring daemon
Documentation=https://github.com/Decipheredmedia/agoradesk-app-foss
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/wp-guardian
EnvironmentFile=/opt/wp-guardian/.env
ExecStart=/opt/wp-guardian/venv/bin/python /opt/wp-guardian/wp_guardian.py --daemon
Restart=on-failure
RestartSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wp-guardian

# Security hardening for the service process itself
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/wp-guardian/wp_guardian.log /opt/wp-guardian/wp_file_hashes.json /var/www/html/wp-config.php /var/www/html/.htaccess

[Install]
WantedBy=multi-user.target
